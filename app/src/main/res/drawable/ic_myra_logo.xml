<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="0"
        android:translateY="0">

        <!-- Background glow circle -->
        <path
            android:pathData="M 54,18 A 36,36 0 1,0 54,90 A 36,36 0 1,0 54,18 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="18"
                    android:startY="18"
                    android:endX="90"
                    android:endY="90"
                    android:type="linear">
                    <item android:color="#338B5CF6" android:offset="0.0" />
                    <item android:color="#3306B6D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Stylized M path -->
        <path
            android:pathData="M 32,68 L 32,38 L 46,54 L 54,44 L 62,54 L 76,38 L 76,68"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="32"
                    android:startY="38"
                    android:endX="76"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#FF8B5CF6" android:offset="0.0" />
                    <item android:color="#FF06B6D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Voice Waveform / Sparkle lines below M -->
        <path
            android:pathData="M 40,76 L 40,80 M 48,76 L 48,84 M 54,74 L 54,86 M 60,76 L 60,84 M 68,76 L 68,80"
            android:strokeWidth="3"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="40"
                    android:startY="76"
                    android:endX="68"
                    android:endY="86"
                    android:type="linear">
                    <item android:color="#FFA78BFA" android:offset="0.0" />
                    <item android:color="#FF22D3EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Sparkle accent top right -->
        <path
            android:pathData="M 72,26 L 74,30 L 78,32 L 74,34 L 72,38 L 70,34 L 66,32 L 70,30 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="66"
                    android:startY="26"
                    android:endX="78"
                    android:endY="38"
                    android:type="linear">
                    <item android:color="#FFC084FC" android:offset="0.0" />
                    <item android:color="#FF38BDF8" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
