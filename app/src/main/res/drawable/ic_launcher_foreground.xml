<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Center group offset for 108x108 adaptive grid (safe zone is central 66dp) -->
    <group
        android:translateX="0"
        android:translateY="0">

        <!-- Stylized M path -->
        <path
            android:pathData="M 32,70 L 32,38 L 46,56 L 54,46 L 62,56 L 76,38 L 76,70"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="32"
                    android:startY="38"
                    android:endX="76"
                    android:endY="70"
                    android:type="linear">
                    <item android:color="#FF8B5CF6" android:offset="0.0" />
                    <item android:color="#FF06B6D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Voice Waveform / Sparkle lines below M -->
        <path
            android:pathData="M 40,76 L 40,80 M 48,76 L 48,84 M 54,74 L 54,86 M 60,76 L 60,84 M 68,76 L 68,80"
            android:strokeWidth="3"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="40"
                    android:startY="76"
                    android:endX="68"
                    android:endY="86"
                    android:type="linear">
                    <item android:color="#FFA78BFA" android:offset="0.0" />
                    <item android:color="#FF22D3EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Sparkle accent top right -->
        <path
            android:pathData="M 72,28 L 74,32 L 78,34 L 74,36 L 72,40 L 70,36 L 66,34 L 70,32 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="66"
                    android:startY="28"
                    android:endX="78"
                    android:endY="40"
                    android:type="linear">
                    <item android:color="#FFC084FC" android:offset="0.0" />
                    <item android:color="#FF38BDF8" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
